# Application & Server
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Database & Security
DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="your-256-bit-secret-key-at-least-32-characters-long"

# Email Configuration
# Options: mock | smtp | resend
EMAIL_PROVIDER="mock"
EMAIL_FROM="no-reply@unb.co.za"
EMAIL_CONTACT_TO="info@unb.co.za"
EMAIL_CAREERS_TO="careers@unb.co.za"

# SMTP Settings (Required if EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_SECURE=false

# CAPTCHA Spam Protection
# Options: mock | turnstile | recaptcha | hcaptcha
CAPTCHA_PROVIDER="mock"
CAPTCHA_SECRET_KEY="your-captcha-secret-key"
CAPTCHA_SCORE_THRESHOLD=0.5

# Object / File Storage Configuration
# Options: local-private | s3 | supabase
STORAGE_PROVIDER="local-private"

# Cloud Storage Settings (Required if STORAGE_PROVIDER=s3 or supabase)
STORAGE_BUCKET="unb-private-storage"
STORAGE_REGION="af-south-1"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
